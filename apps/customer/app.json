{
  "expo": {
    "name": "BookMyTurn",
    "slug": "bookmyturn-customer",
    "scheme": "bookmyturn",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bookmyturn.customer"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.bookmyturn.customer"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "BookMyTurn"
    }
  }
}
