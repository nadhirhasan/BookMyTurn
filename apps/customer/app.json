{
  "expo": {
    "name": "BookMyTurn",
    "slug": "bookmyturn-customer",
    "scheme": "bookmyturn",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FCF6ED",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the BookMyTurn QR at your salon.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose haircut photos to save and share with your barber.",
          "cameraPermission": "Scan the BookMyTurn QR at your salon.",
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bookmyturn.customer"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#087F80",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.bookmyturn.customer"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "BookMyTurn"
    }
  }
}
