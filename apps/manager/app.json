{
  "expo": {
    "name": "BookMyTurn Manager",
    "slug": "bookmyturn-barber",
    "scheme": "bookmyturn-barber",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "../customer/assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#141613",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos for your salon, team or account profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Use your location to pin the salon entrance on the map.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bookmyturn.barber"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141613",
        "foregroundImage": "../customer/assets/icon.png"
      },
      "package": "com.bookmyturn.barber"
    },
    "web": {
      "favicon": "../customer/assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "BookMyTurn Manager"
    }
  }
}
