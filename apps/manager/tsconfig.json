{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": [
      "react",
      "react-native",
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@core/*": [
        "../customer/src/lib/supabase/*"
      ],
      "@customer/*": [
        "../customer/src/*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
