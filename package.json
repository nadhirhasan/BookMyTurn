{
  "name": "bookmyturn",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "overrides": {
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "scripts": {
    "start": "npm run start --workspace=@bookmyturn/customer --",
    "start:tunnel": "npm run start:tunnel --workspace=@bookmyturn/customer --",
    "android": "npm run android --workspace=@bookmyturn/customer --",
    "ios": "npm run ios --workspace=@bookmyturn/customer --",
    "web": "npm run web --workspace=@bookmyturn/customer --",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run lint && npm run typecheck",
    "export:web": "npm run export:web --workspace=@bookmyturn/customer",
    "check:supabase": "npm run check:supabase --workspace=@bookmyturn/customer",
    "barber": "npm run start --workspace=@bookmyturn/manager --",
    "barber:tunnel": "npm run start:tunnel --workspace=@bookmyturn/manager --",
    "barber:web": "npm run web --workspace=@bookmyturn/manager --",
    "manager": "npm run start --workspace=@bookmyturn/manager --",
    "manager:tunnel": "npm run start:tunnel --workspace=@bookmyturn/manager --",
    "manager:web": "npm run web --workspace=@bookmyturn/manager --"
  }
}
